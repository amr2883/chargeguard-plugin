# ChargeGuard for WooCommerce ??? .distignore
# Used by `wp dist-archive` and by build.ps1 to produce the release ZIP.
# Patterns follow .gitignore syntax (fnmatch-style, supports ! negation).

# ?????? Version control ???????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????
.git
.gitignore
.gitattributes
.github

# ?????? Local environment / secrets ???????????????????????????????????????????????????????????????????????????????????????
.env
.env.*
*.env
.htaccess.bak
wp-config-sample.php

# ?????? OS / editor cruft ????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea
.vscode

# ?????? Backups, logs, temp files ?????????????????????????????????????????????????????????????????????????????????????????????
*.bak
*.orig
*.log
*.tmp
*.zip
error_log
debug.log

# Draft, parked, and work-in-progress files — durable convention, not
# a one-off rule. Anything named "_deferred.*" is parked architectural
# reference code that is not wired into the plugin, and its header
# comments may describe known bugs or internal design in more detail
# than a downloaded ZIP should expose. "*.txt.js" is our convention for
# a JS file deliberately neutered from being auto-enqueued. Do NOT
# remove these two patterns as "unused" — they exist precisely so any
# *future* file matching this naming convention is excluded
# automatically, without anyone needing to add a new .distignore line.
_deferred.*
*.txt.js

# Put draft/WIP/parked notes under dev-notes/ at the plugin root
# instead of inline under assets/ or includes/ — this whole directory
# is excluded, so nothing placed there can ever ship by accident. The
# folder does not need to exist yet for this rule to be valid.
dev-notes

# ?????? Dev dependencies / build tooling (root level) ?????????????????????????????????
node_modules
package.json
package-lock.json
composer.lock
phpunit.xml
phpunit.xml.dist
.phpcs.xml
.phpcs.xml.dist
phpcs.xml
phpcs.xml.dist
.eslintrc*
.stylelintrc*
webpack.config.js
gulpfile.js
Gruntfile.js
build.ps1
build.sh
.distignore

# ?????? Tests (root level) ?????????????????????????????????????????????????????????????????????????????????????????????????????????????????????
tests
test
bin

# ?????? Documentation not needed at runtime ???????????????????????????????????????????????????????????????
CONTRIBUTING.md
CODE_OF_CONDUCT.md
*.psd
*.ai
*.sketch

# ?????? Vendor: strip dev/CI metadata, keep runtime SDK files ?????????
# Composer's own manifest/lock ??? not needed once vendor/ is vendored in.
composer.json
composer.lock

# Stripe PHP SDK ??? exclude packaging/CI/doc metadata by exact
# top-level filename, never by wildcarding the data/ directory,
# so the CA bundle below is never at risk from a broader pattern.
vendor/stripe-php/.git
vendor/stripe-php/.gitignore
vendor/stripe-php/.gitattributes
vendor/stripe-php/.github
vendor/stripe-php/.styleci.yml
vendor/stripe-php/.php-cs-fixer.dist.php
vendor/stripe-php/CHANGELOG.md
vendor/stripe-php/README.md
vendor/stripe-php/UPGRADING.md
vendor/stripe-php/LICENSE
vendor/stripe-php/OPENAPI_VERSION
vendor/stripe-php/VERSION
vendor/stripe-php/composer.json
vendor/stripe-php/phpunit.xml.dist
vendor/stripe-php/phpunit.xml
vendor/stripe-php/build
vendor/stripe-php/bin
vendor/stripe-php/tests

# Explicitly re-include the CA bundle the SDK needs at runtime,
# in case any broader rule above would otherwise have matched it.
!vendor/stripe-php/data
!vendor/stripe-php/data/ca-certificates.crt
!vendor/stripe-php/init.php
!vendor/stripe-php/lib
